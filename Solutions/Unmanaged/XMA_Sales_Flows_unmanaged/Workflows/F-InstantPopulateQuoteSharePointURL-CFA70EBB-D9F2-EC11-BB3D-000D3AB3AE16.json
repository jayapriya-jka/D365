                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_webcontents"
                },
                "parameters": {
                  "request/method": "GET",
                  "request/url": "@variables('GetRequestURL')"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Update_a_row": {
              "runAfter": {
                "Invoke_an_HTTP_request": [
                  "Succeeded"
                ]
              },
              "metadata": {
                "operationMetadataId": "baad8774-55c3-4e34-bb80-8f6e242b8834"
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
