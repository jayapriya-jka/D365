                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps"
                },
                "parameters": {
                  "entityName": "quotes",
                  "recordId": "@triggerOutputs()?['body/_regardingobjectid_value']",
                  "item/igl_sharepointurl": "@body('Invoke_an_HTTP_request')?['AbsoluteUrl']"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "runAfter": {
            "Initialize_variable": [
              "Succeeded"
            ]
          },
          "expression": {
            "equals": [
              "@triggerOutputs()?['body/_regardingobjectid_value@Microsoft.Dynamics.CRM.lookuplogicalname']",
              "quote"
            ]
          },
          "metadata": {
            "operationMetadataId": "5014c074-db50-476d-98e1-40b8c3bcab9c"
